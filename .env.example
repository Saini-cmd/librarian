# ---- Model APIs (outsourced) ----

# OpenRouter API (embeddings + reranking)
OPENROUTER_API_KEY=

# LLM (DeepSeek via OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_OUTPUT_TOKENS=1024
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_RETRIES=3
DEEPSEEK_RETRY_BACKOFF_SECONDS=1.0

# ---- Local infra ----

# Qdrant mode: server (default, local Docker) | cloud (dormant) | embedded (dormant)
QDRANT_MODE=server
QDRANT_LOCAL_URL=http://localhost:6333

# PostgreSQL (local Dockerized server)
DATABASE_URL=postgresql+psycopg2://librarian:librarian@localhost:5432/librarian
# Connection pool ceiling — raise for busier multi-user deployments (pipelines
# don't hold a connection across their run, so steady state is short-lived)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis (background ARQ worker — chat-memory vectorization + session summaries; also the ingest lock)
REDIS_URL=redis://localhost:6379/0

# ---- Deployment hardening ----

# Comma-separated CORS origins the backend accepts (dev defaults are the Vite
# dev servers). Set to your real frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
# FastAPI sync-endpoint thread pool per worker (chat concurrency ceiling)
THREADPOOL_SIZE=40

# ---- Concurrent ingest lock (wait-and-reuse) ----
# Prevents two users ingesting the same repo commit simultaneously. Redis
# SET NX EX keyed by commit hash; falls back to an in-process lock when Redis is down.
INGEST_LOCK_TTL_SECONDS=900
INGEST_WAIT_MAX_SECONDS=1800
INGEST_WAIT_POLL_SECONDS=2
# Global cap on concurrent pipelines across all users/commits (0 = unlimited) —
# protects OpenRouter/DeepSeek rate limits and spend under bursts
INGEST_MAX_CONCURRENT=2

# ---- Chat memory ----

# Short-term: how many recent turns to feed the LLM; rolling-summary fallback token budget
MEMORY_HISTORY_TURNS=10
MEMORY_HISTORY_TOKENS=6000
# Long-term: top-K raw memory chunks retrieved per query
MEMORY_TOP_K=5
# Background session summary: summarize once this many new messages accumulate (deferred enqueues)
MEMORY_SUMMARIZE_EVERY=10
MEMORY_SUMMARIZE_DEFER_SECONDS=60

# ---- RAG context (precision-over-recall curation, all OFF by default) ----

# Max context chunks fed to the LLM
RAG_CONTEXT_MAX_CHUNKS=8
# Cap chunks per file in the context (0 = off); keeps the highest-scored ones
RAG_CONTEXT_MAX_PER_FILE=0
# Absolute rerank-score floor (0 = off)
RAG_CONTEXT_MIN_SCORE=0.0
# Relative floor vs the top score, e.g. 0.4 keeps chunks >= 40% of the best (0 = off); top chunk always kept
RAG_CONTEXT_MIN_SCORE_RATIO=0.0

# ---- Retrieval cache ----

# Max per-commit BM25 indexes kept in the shared in-process cache (LRU). Bounded
# so concurrent chat across many repos doesn't leak memory.
BM25_CACHE_SIZE=16

# ---- Summarization (shared by ingestion FileSummarizer + memory rollup) ----

# OpenRouter cheap summarization model (OpenAI-compatible /api/v1)
SUMMARIZE_MODEL=inclusionai/ling-3.0-flash
SUMMARIZE_BASE_URL=https://openrouter.ai/api/v1
# SUMMARIZE_API_KEY=          # falls back to OPENROUTER_API_KEY
SUMMARIZE_MAX_TOKENS=300
# Retry transient LLM failures (rate limits) with exponential backoff
SUMMARIZE_MAX_ATTEMPTS=3      # attempts per file (backoff 2s, 4s, ...)
SUMMARIZE_CONCURRENCY=5       # parallel summarize workers

# ---- Usage caps (24h per-user, rolling window) ----
# Postgres-backed counts (correct across workers, no Redis needed). 0 = unlimited.
# Actions per group: ingest = repo_ingest (process pipeline) + repo_sync (sync re-ingest);
# message = chat_message (chat/chat/stream) + explain. Zero-spend reuse paths (skip-to-chat
# reuse of an already-indexed commit, up-to-date sync no-op) never count.
USAGE_INGEST_MAX=2
USAGE_MESSAGE_MAX=20
USAGE_WINDOW_SECONDS=86400

# Repo-size gates (enforced in the orchestrator BEFORE any LLM/embed spend):
# max files after scan (also bounds summarize calls) and max chunks after chunking (bounds
# embed calls + Qdrant storage). 0 = unlimited.
USAGE_MAX_REPO_FILES=300
USAGE_MAX_REPO_CHUNKS=6000

# ---- Optional ----

# GitHub API (optional, higher rate limit with token)
GITHUB_TOKEN=

# Clerk auth
CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY= (local only)
# CLERK_WEBHOOK_SECRET= (webhook receiver)

# Frontend (frontend/.env — Vite reads it from the frontend dir)
# VITE_CLERK_PUBLISHABLE_KEY=

# ---- Dormant cloud path (unused) ----
# QDRANT_URL=
# QDRANT_API_KEY=
